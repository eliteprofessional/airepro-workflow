# Example production secrets for Jenkins deploy.
# Install on the agent as: /home/airepro/.secrets/airepro-workflow.env
# chmod 600 that file. Never commit real passwords.

DATABASE_URL=mysql://elitepro_workflow:CHANGE_ME@pole.hostitbro.com:3306/elitepro_workflow
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BASE_URL=https://workflow.airepro.in
NEXTAUTH_URL=https://workflow.airepro.in
NEXT_PUBLIC_APP_URL=https://workflow.airepro.in
NEXT_PUBLIC_API_URL=https://workflow.airepro.in/api
AUTH_TRUST_HOST=true
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=1730
APP_NAME=WA-AKG
BAILEYS_LOG_LEVEL=error
NEXT_PUBLIC_SWAGGER_ENABLED=true
NEXT_PUBLIC_SWAGGER_USERNAME=admin
NEXT_PUBLIC_SWAGGER_PASSWORD=change-this-in-production
ADMIN_EMAIL=workflow@airepro.in
ADMIN_PASSWORD=change-this-in-production
TZ=Asia/Kolkata
LOCALE=en-IN
